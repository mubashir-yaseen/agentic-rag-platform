# ==============================================================================
# RAG Platform Environment Configuration (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# Application & Logging
APP_NAME="RAG Chatbot Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
LOG_JSON_FORMAT="false"

# Supabase Credentials & Database
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
SUPABASE_ANON_KEY="your_anon_key_here"

# LLM Providers (OpenRouter / OpenAI)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
LLM_MODEL_MODE=auto
#LLM_MODEL=nvidia/nemotron-3.5-lightning:free
#LLM_MODEL=inclusionai/ling-3.0-flash-fin:free
#LLM_MODEL=deepseek/deepseek-v4-flash-0731:free
#LLM_MODEL_MODE=fixed

OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-3.5-turbo"

# Embeddings (768 numbers per text; the database column is vector(768))
# Uncomment ONE option and fill it in (placeholder values left uncommented would be treated as real keys).
# Option A (recommended, free, ~10,000 "neurons"/day): Cloudflare Workers AI. Dashboard > AI > Workers AI > Use REST API.
#CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
#CLOUDFLARE_API_TOKEN="your_workers_ai_api_token"
# Option B (free, but only 1,000 texts per day): Google Gemini. https://aistudio.google.com/app/apikey
#GOOGLE_API_KEY="your_google_api_key"
# If both are set, Cloudflare is used. Vectors from different providers cannot be mixed: pick one per database.

# Optional: caps the number of NEW chunks embedded per UTC day by upload_company_report.py (default 3500)
#RAG_DAILY_CHUNK_BUDGET="3500"
# Optional: where the uploader keeps its saved progress (default .embed_cache)
#RAG_CACHE_DIR=".embed_cache"

# RAG Chunking and Retrieval Tuning
RAG_CHUNK_SIZE="1000"
RAG_CHUNK_OVERLAP="200"
RAG_K_RESULTS="3"
RAG_TEMPERATURE="0.2"

# Observability & Tracing (Langfuse / LangSmith)
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY="lsv2_pt_..."
LANGSMITH_PROJECT="rag-platform"

