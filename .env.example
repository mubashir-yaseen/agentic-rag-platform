# ==============================================================================
# RAG Platform Environment Configuration (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# Application & Logging
APP_NAME="RAG Chatbot Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
LOG_JSON_FORMAT="false"

# Supabase Credentials & Database
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"
SUPABASE_ANON_KEY="your_anon_key_here"

# LLM Providers (OpenRouter / OpenAI)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
LLM_MODEL_MODE=auto
#LLM_MODEL=nvidia/nemotron-3.5-lightning:free
#LLM_MODEL=inclusionai/ling-3.0-flash-fin:free
#LLM_MODEL=deepseek/deepseek-v4-flash-0731:free
#LLM_MODEL_MODE=fixed

OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-3.5-turbo"

# HuggingFace & Local Embeddings
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
HUGGINGFACEHUB_API_TOKEN="your_huggingface_token_here"

# RAG Chunking and Retrieval Tuning
RAG_CHUNK_SIZE="1000"
RAG_CHUNK_OVERLAP="200"
RAG_K_RESULTS="3"
RAG_TEMPERATURE="0.2"

# Vector Store Storage Backend
VECTOR_STORE_DIR="vector_stores"
VECTOR_STORE_BACKEND="faiss"

# Observability & Tracing (Langfuse / LangSmith)
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_HOST="https://cloud.langfuse.com"
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY="lsv2_pt_..."
LANGSMITH_PROJECT="rag-platform"

